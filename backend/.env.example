GNANI_API_KEY=your_key_here
GNANI_TTS_VOICE=Priyasharm

# Ledger backend (Phase 6). Leave unset to keep the local-only demo flow. No credentials belong here.
# VAADA_LEDGER_API_URL=http://127.0.0.1:8000
# VAADA_LEDGER_API_TIMEOUT=5
# VAADA_LEDGER_API_RETRIES=2

# Voice gateway (optional overrides; the key itself goes only in your local .env)
# GNANI_STT_FORMAT=transliterate
# GNANI_STT_TIMEOUT=20

# Voice authentication (all optional; off by default; see docs/voice_auth.md). Never commit real values.
# VAADA_VOICE_AUTH_MODE=off
# VAADA_SPEAKER_THRESHOLD=      (no default on purpose: calibrate on your own users)
# VAADA_VOICEPRINT_KEY=         (generate: python -c "from voice_auth.store import generate_key; print(generate_key())")
# VAADA_ADMIN_TOKEN=            (enables the controlled enrollment endpoints)
# VAADA_AUTH_SESSION_TTL_S=300
# VAADA_ANTISPOOF=off

# Text-to-speech (Gnani Timbre), optional audio layer; see docs/voice_tts.md
# VAADA_TTS_ENABLED=false
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_LANGUAGE=hi-en
# GNANI_TTS_SPEED=1.0
# GNANI_TTS_SAMPLE_RATE=24000
# GNANI_TTS_TIMEOUT=8
# VAADA_TTS_MAX_CHARS=500

# Ledger backend authentication (Phase 8). The merchant identity belongs to the BACKEND; see docs/backend_integration_contract.md
# VAADA_LEDGER_AUTH_MODE=none          (none | static | passthrough)
# VAADA_LEDGER_API_TOKEN=              (static mode only: one merchant's backend session token; never commit a real one)
